{
  "name": "@eforge-build/pi-eforge",
  "version": "0.7.21",
  "description": "eforge integration for Pi - enqueue, run, and monitor builds from within Pi",
  "keywords": [
    "pi-package"
  ],
  "homepage": "https://eforge.build",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eforge-build/eforge.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "extensions/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "type-check": "pnpm --filter @eforge-build/client build && pnpm --filter @eforge-build/scopes build && pnpm --filter @eforge-build/extension-sdk build && pnpm --filter @eforge-build/engine build && tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./extensions/eforge"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@sinclair/typebox": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": false
    },
    "@earendil-works/pi-ai": {
      "optional": false
    },
    "@earendil-works/pi-tui": {
      "optional": false
    },
    "@sinclair/typebox": {
      "optional": false
    },
    "typebox": {
      "optional": false
    }
  },
  "dependencies": {
    "@eforge-build/client": "workspace:*",
    "@eforge-build/engine": "workspace:*",
    "typebox": "^1.3.0",
    "yaml": "^2.9.0"
  },
  "author": "Schaake Solutions LLC",
  "license": "Apache-2.0"
}
