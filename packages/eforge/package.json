{
  "name": "@eforge-build/eforge",
  "version": "0.8.1",
  "description": "Autonomous plan-build-review CLI for code generation",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "eforge": "./dist/cli.js"
  },
  "exports": {
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eforge-build/eforge.git"
  },
  "homepage": "https://eforge.build",
  "keywords": [
    "ai",
    "agent",
    "code-generation",
    "claude"
  ],
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@eforge-build/client": "workspace:*",
    "@eforge-build/engine": "workspace:*",
    "@eforge-build/input": "workspace:*",
    "@eforge-build/monitor": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "ora": "^9.4.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "author": "Schaake Solutions LLC"
}
