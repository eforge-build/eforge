{
  "name": "eforge-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eforge-build/eforge.git"
  },
  "homepage": "https://eforge.build",
  "scripts": {
    "build": "pnpm -r build",
    "build:ui": "pnpm --filter @eforge-build/console-ui build",
    "build:console-ui": "pnpm --filter @eforge-build/console-ui build",
    "restart-daemon": "eforge daemon stop && eforge daemon start",
    "build-and-restart": "pnpm build && pnpm restart-daemon",
    "dev:console": "pnpm --filter @eforge-build/console-ui dev",
    "dev:eforge-plan-workstation": "pnpm --filter @eforge-build/eforge-plan-workstation dev",
    "dev:eforge-plan-workstation:daemon": "node scripts/dev-eforge-plan-workstation.mjs",
    "build:eforge-plan-workstation": "pnpm --filter @eforge-build/eforge-plan-workstation build",
    "storybook": "pnpm --filter @eforge-build/console-ui storybook",
    "storybook:build": "pnpm --filter @eforge-build/console-ui build-storybook",
    "storybook:eforge-plan": "pnpm --filter @eforge-build/eforge-plan-workstation storybook",
    "storybook:build:eforge-plan": "pnpm --filter @eforge-build/eforge-plan-workstation build-storybook",
    "test": "node scripts/check-skill-parity.mjs && vitest run --silent",
    "vitest": "node scripts/vitest-wrapper.mjs",
    "test:watch": "vitest",
    "type-check": "pnpm --filter @eforge-build/engine... --filter @eforge-build/monitor... --filter @eforge-build/eforge... --workspace-concurrency=1 build && pnpm -r type-check",
    "type-check:eforge-plan": "pnpm --filter @eforge-build/eforge-plan type-check",
    "type-check:eforge-playbooks": "pnpm --filter @eforge-build/eforge-playbooks type-check",
    "release": "node scripts/bump-version.mjs",
    "publish-all": "node scripts/publish-all.mjs",
    "docs:check-parity": "node scripts/check-skill-parity.mjs",
    "docs:generate": "pnpm --filter @eforge-build/docs-gen... --workspace-concurrency=1 build && node packages/docs-gen/dist/cli.js generate --all",
    "docs:check": "pnpm --filter @eforge-build/docs-gen... --workspace-concurrency=1 build && node packages/docs-gen/dist/cli.js check",
    "docs:dev": "pnpm docs:generate && pnpm --filter @eforge-build/web dev",
    "docs:build": "pnpm docs:generate && pnpm --filter @eforge-build/web build",
    "complexity:scan": "node scripts/scan-complexity.mjs",
    "maintainability:check": "node scripts/check-agent-maintainability.mjs"
  },
  "packageManager": "pnpm@10.26.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "esbuild": ">=0.28.1",
      "postcss": ">=8.5.15"
    }
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.80.5",
    "@earendil-works/pi-ai": "^0.80.5",
    "@earendil-works/pi-coding-agent": "^0.80.5",
    "@eforge-build/client": "workspace:*",
    "@eforge-build/console-ui": "workspace:*",
    "@eforge-build/docs-gen": "workspace:*",
    "@eforge-build/engine": "workspace:*",
    "@eforge-build/monitor": "workspace:*",
    "@eforge-build/scopes": "workspace:*",
    "@eforge-build/web": "workspace:*",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.1",
    "commander": "^15.0.0",
    "eslint": "^10.6.0",
    "eslint-plugin-sonarjs": "^4.1.0",
    "jsdom": "^29.1.1",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
